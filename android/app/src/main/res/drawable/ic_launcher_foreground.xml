<?xml version="1.0" encoding="utf-8"?>
<!-- MedMinder icon: a pill across a clock face ("medicine on time").
     Everything stays inside the 66dp safe zone so no launcher crops it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Clock face -->
    <path
        android:fillColor="#FF3B73BD"
        android:pathData="M28,54a26,26 0,1 0,52 0a26,26 0,1 0,-52 0" />

    <!-- Hour marks at 12, 3, 6 and 9 -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="0">
        <path android:fillColor="#CCFFFFFF" android:pathData="M52.75,31.5h2.5v5.5h-2.5z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="90">
        <path android:fillColor="#CCFFFFFF" android:pathData="M52.75,31.5h2.5v5.5h-2.5z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="180">
        <path android:fillColor="#CCFFFFFF" android:pathData="M52.75,31.5h2.5v5.5h-2.5z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="270">
        <path android:fillColor="#CCFFFFFF" android:pathData="M52.75,31.5h2.5v5.5h-2.5z" />
    </group>

    <!-- Capsule, tilted like clock hands: white half and amber half -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="-45">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M54,46L44,46A8,8 0,0 0,44 62L54,62Z" />
        <path
            android:fillColor="#FFF4B43A"
            android:pathData="M54,46L64,46A8,8 0,0 1,64 62L54,62Z" />
    </group>
</vector>
